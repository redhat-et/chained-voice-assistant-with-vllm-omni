# LiveKit Server (dev mode defaults)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# STT — faster-whisper-server (CPU, OpenAI-compatible)
STT_BASE_URL=http://localhost:8001/v1
STT_MODEL=Systran/faster-whisper-large-v3

# LLM — vLLM (GPU, OpenAI-compatible)
LLM_BASE_URL=http://localhost:8002/v1
LLM_MODEL=google/gemma-3-4b-it

# TTS — vLLM-Omni (GPU, OpenAI-compatible)
TTS_BASE_URL=http://localhost:8003/v1
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_VOICE=vivian

# Frontend — set to server hostname when accessing remotely
# ALLOWED_DEV_ORIGIN=my-server.example.com
