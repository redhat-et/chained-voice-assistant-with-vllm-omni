# ---- Required ----
HF_TOKEN=hf_your_token_here

# ---- Network (Terraform sets these automatically) ----
PRIVATE_IP=localhost
PUBLIC_IP=localhost

# ---- GPU allocation (fraction of GPU memory per service) ----
LLM_GPU_UTIL=0.4
TTS_GPU_UTIL=0.4

# ---- Active models (model-manager updates these at runtime) ----
STT_ACTIVE_MODEL=Systran/faster-whisper-large-v3
LLM_ACTIVE_MODEL=google/gemma-3-4b-it
TTS_ACTIVE_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_VOICE=vivian

# ---- HuggingFace model cache ----
HF_CACHE_DIR=./hf-cache

# ---- LiveKit (dev defaults — change for production) ----
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
